Options -Indexes -MultiViews
DirectoryIndex index.html

<FilesMatch "(^\.|\.(?:sqlite|sqlite3|log|bak)$|^(?:composer\.(?:json|lock)|package(?:-lock)?\.json)$)">
Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On
# Leave the PHP endpoint and all real static files alone.
RewriteRule ^api(?:/|$) - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# React handles the 53 clean routes and legacy .html links.
RewriteCond %{REQUEST_URI} !\.(?:js|css|png|jpe?g|gif|webp|svg|ico|json|php|woff2?)$ [NC]
RewriteRule ^ index.html [L]
RewriteRule ^[a-z0-9-]+\.html$ index.html [L,NC]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
